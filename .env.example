# Copy to .env for local configuration. On Hugging Face Spaces set these as Variables (and HF_TOKEN as a Secret).
# HF_TOKEN must never be written into this file, the code or the Dockerfile.

# Application
NF_LOG_LEVEL=INFO
NF_LOG_JSON=true
NF_PORT=7860
NF_CORS_ALLOW_ORIGINS=["*"]
NF_FORWARDED_ALLOW_IPS=*

# Frames
NF_FRAMES_ARE_MIRRORED=false
NF_MAX_FRAME_BYTES=1500000
NF_PROCESSING_MAX_DIMENSION=960
NF_FRAME_QUEUE_SIZE=2

# WebSocket timeouts (seconds)
NF_WS_PING_INTERVAL_SECONDS=20
NF_WS_PING_TIMEOUT_SECONDS=20
NF_WS_KEEPALIVE_INTERVAL_SECONDS=15
NF_WS_IDLE_TIMEOUT_SECONDS=120
NF_READY_TIMEOUT_SECONDS=300
NF_QUALITY_WAIT_TIMEOUT_SECONDS=90

# Models
NF_REASONING_MODEL_ID=Qwen/Qwen3-VL-4B-Instruct
NF_REASONING_MODEL_NAME=qwen3-vl-4b
NF_CONSULTANT_MODEL_ID=google/medgemma-1.5-4b-it
NF_CONSULTANT_MODEL_NAME=medgemma-1.5-4b
NF_MEDSIGLIP_MODEL_ID=google/medsiglip-448
NF_RTMW_MODE=balanced
NF_YOLOE_WEIGHTS_NAME=yoloe-11s-seg.pt
NF_CLASSIFIER_STRATEGY=auto

# Internal vLLM servers
REASONING_PORT=8001
CONSULTANT_PORT=8002
REASONING_GPU_MEMORY_UTILIZATION=0.32
CONSULTANT_GPU_MEMORY_UTILIZATION=0.30
REASONING_QUANTIZATION=fp8
CONSULTANT_QUANTIZATION=fp8
REASONING_MAX_MODEL_LEN=8192
CONSULTANT_MAX_MODEL_LEN=4096
VLLM_ENFORCE_EAGER=0
LLM_STARTUP_TIMEOUT=1800

# Privacy: frames are never stored; enable only to save crops used in reports
NF_SAVE_REPORT_CROPS=false

# Sessions
NF_SESSION_TTL_SECONDS=3600
NF_MAX_SESSIONS=200
